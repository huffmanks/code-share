---
import Default from "@astrojs/starlight/components/PageSidebar.astro";
import config from "virtual:starlight-page-context-action-config";
import PageContextActions from "../components/PageContextActions.astro";

const entryData = Astro.locals.starlightRoute.entry.data as { pageContextActions?: boolean };
const showPageContextActions = entryData.pageContextActions !== false;

const entryFilePath = Astro.locals.starlightRoute.entry.filePath;
const position = config.position ?? "above-toc";
const sticky = config.sticky ?? false;
const wrapperClasses = [
  "page-context-action__wrapper",
  "right-sidebar-panel",
  "sl-hidden",
  "lg:sl-block",
  position === "above-toc" ? "page-context-action__above-toc" : "page-context-action__below-toc",
  sticky && "page-context-action__sticky",
]
  .filter(Boolean)
  .join(" ");
---

{
  showPageContextActions && position === "above-toc" && (
    <div class={wrapperClasses}>
      <div class="sl-container">
        <PageContextActions entryFilePath={entryFilePath} />
      </div>
    </div>
  )
}

<Default><slot /></Default>

{
  showPageContextActions && position === "below-toc" && (
    <div class={wrapperClasses}>
      <div class="sl-container">
        <PageContextActions entryFilePath={entryFilePath} />
      </div>
    </div>
  )
}

<style>
  .page-context-action__wrapper {
    padding: 1rem var(--sl-sidebar-pad-x);
  }

  .page-context-action__wrapper.page-context-action__above-toc {
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .page-context-action__wrapper.page-context-action__below-toc {
    border-top: 1px solid var(--sl-color-hairline);
  }

  .page-context-action__wrapper.page-context-action__sticky {
    position: sticky;
    top: 0;
    z-index: 1;
    background-color: var(--sl-color-bg);
  }

  .page-context-action__wrapper.page-context-action__below-toc.page-context-action__sticky {
    top: auto;
    bottom: -1px;
  }
</style>
