<script is:inline define:vars={{ prompt, base, rawSourcePath }}>
  (function () {
    // --- Shared copy handler ---
    function handleCopy(btn) {
      return async () => {
        const iconCopy = btn.querySelector(".page-context-action__icon-copy");
        const iconCheck = btn.querySelector(".page-context-action__icon-check");
        const iconError = btn.querySelector(".page-context-action__icon-error");

        try {
          const normalizedBase = base.replace(/\/$/, "");
          const rawUrl = (normalizedBase ? normalizedBase + "/" : "/") + rawSourcePath;
          const res = await fetch(rawUrl);
          if (!res.ok) throw new Error("Could not fetch page source");
          const rawText = await res.text();
          await navigator.clipboard.writeText(rawText);

          if (iconCopy) iconCopy.style.display = "none";
          if (iconCheck) iconCheck.style.display = "";
          setTimeout(() => {
            if (iconCheck) iconCheck.style.display = "none";
            if (iconCopy) iconCopy.style.display = "";
          }, 3000);
        } catch (err) {
          console.error("Copy page failed:", err);
          if (iconCopy) iconCopy.style.display = "none";
          if (iconError) iconError.style.display = "";
          setTimeout(() => {
            if (iconError) iconError.style.display = "none";
            if (iconCopy) iconCopy.style.display = "";
          }, 3000);
        }
      };
    }

    // --- Scroll to top button ---
    document.querySelectorAll("#page-context-action-scroll-top").forEach((btn) => {
      btn.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    });

    // --- Copy page button (both layouts) ---
    const copyBtn = document.getElementById("page-context-action-copy");
    if (copyBtn) {
      copyBtn.addEventListener("click", handleCopy(copyBtn));
    }

    // --- Compact layout: copy item inside kebab dropdown ---
    document.querySelectorAll("[data-compact-copy]").forEach((item) => {
      item.addEventListener("click", async () => {
        // Delegate to the main copy button if present
        if (copyBtn) {
          copyBtn.click();
        }
        // Close the dropdown
        const dropdown = document.getElementById("page-context-action-dropdown");
        if (dropdown) dropdown.style.display = "none";
        const kebab = document.getElementById("page-context-action-kebab");
        if (kebab) kebab.setAttribute("aria-expanded", "false");
      });
    });

    // --- AI service URLs (shared) ---
    const dropdown = document.getElementById("page-context-action-dropdown");
    if (dropdown) {
      const pageUrl = window.location.href;
      const encodedPrompt = encodeURIComponent(prompt.replace("{url}", pageUrl));

      const serviceUrls = {
        chatgpt: "https://chatgpt.com/?q=" + encodedPrompt,
        claude: "https://claude.ai/new?q=" + encodedPrompt,
        t3chat: "https://t3.chat/new?q=" + encodedPrompt,
      };

      dropdown.querySelectorAll("[data-ai-service]").forEach((link) => {
        const service = link.getAttribute("data-ai-service");
        if (serviceUrls[service]) {
          link.href = serviceUrls[service];
        }
      });
    }

    // --- Popup positioning helper ---
    function positionPopup(triggerEl, popupEl) {
      const gap = 8;
      const rect = triggerEl.getBoundingClientRect();
      const popupHeight = popupEl.offsetHeight;
      const popupWidth = popupEl.offsetWidth;
      const spaceAbove = rect.top;
      const spaceBelow = window.innerHeight - rect.bottom;

      // Vertical: prefer above, fall back to below
      if (spaceAbove >= popupHeight + gap) {
        popupEl.style.top = rect.top - popupHeight - gap + "px";
      } else {
        popupEl.style.top = rect.bottom + gap + "px";
      }

      // Horizontal: align left edge with trigger, clamp to viewport
      let left = rect.left;
      if (left + popupWidth > window.innerWidth - gap) {
        left = window.innerWidth - popupWidth - gap;
      }
      if (left < gap) left = gap;
      popupEl.style.left = left + "px";
    }

    // --- Spread layout: "Open in Chat" dropdown toggle ---
    const openInChatBtn = document.getElementById("page-context-action-open-in-chat");
    if (openInChatBtn && dropdown) {
      openInChatBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        const isOpen = dropdown.style.display !== "none";
        dropdown.style.display = isOpen ? "none" : "";
        openInChatBtn.setAttribute("aria-expanded", String(!isOpen));
        if (!isOpen) positionPopup(openInChatBtn, dropdown);
      });

      document.addEventListener("click", (e) => {
        if (!dropdown.contains(e.target) && e.target !== openInChatBtn) {
          dropdown.style.display = "none";
          openInChatBtn.setAttribute("aria-expanded", "false");
        }
      });
    }

    // --- Compact layout: kebab dropdown toggle ---
    const kebabBtn = document.getElementById("page-context-action-kebab");
    if (kebabBtn && dropdown) {
      kebabBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        const isOpen = dropdown.style.display !== "none";
        dropdown.style.display = isOpen ? "none" : "";
        kebabBtn.setAttribute("aria-expanded", String(!isOpen));
        if (!isOpen) positionPopup(kebabBtn, dropdown);
      });

      document.addEventListener("click", (e) => {
        if (!dropdown.contains(e.target) && e.target !== kebabBtn) {
          dropdown.style.display = "none";
          kebabBtn.setAttribute("aria-expanded", "false");
        }
      });
    }
  })();
</script>

