---
import config from "virtual:starlight-page-context-action-config";

interface Props {
  entryFilePath: string;
}

const { entryFilePath } = Astro.props;
const { actions, prompt, layout } = config;
const anyAiEnabled = actions.chatgpt || actions.claude || actions.t3chat;
const showKebab = anyAiEnabled || actions.viewMarkdown;
const isCompact = layout === "compact";
const base = import.meta.env.BASE_URL;
const rawSourcePath = (() => {
  const relative = entryFilePath.replace(/^src\/content\/docs\//, "").replace(/\.mdx?$/, "");
  const segments = relative.split("/");
  const fileName = segments[segments.length - 1];
  if (fileName === "index") {
    if (segments.length === 1) return "index.md";
    const dirs = segments.slice(0, -2).join("/");
    const folder = segments[segments.length - 2];
    return dirs ? `${dirs}/${folder}.md` : `${folder}.md`;
  }
  const dirs = segments.slice(0, -1).join("/");
  return dirs ? `${dirs}/${fileName}.md` : `${fileName}.md`;
})();
---

{
  isCompact && (
    <div class="page-context-action page-context-action__compact">
      {actions.copy && (
        <button class="page-context-action__compact-copy-btn" id="page-context-action-copy" type="button">
          <svg
            class="page-context-action__icon page-context-action__icon-copy"
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
          </svg>
          <svg
            class="page-context-action__icon page-context-action__icon-check"
            style="display:none"
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12" />
          </svg>
          <svg
            class="page-context-action__icon page-context-action__icon-error"
            style="display:none"
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round">
            <circle cx="12" cy="12" r="10" />
            <line x1="15" y1="9" x2="9" y2="15" />
            <line x1="9" y1="9" x2="15" y2="15" />
          </svg>
          <span>Copy page</span>
        </button>
      )}

      {actions.scrollTop && (
        <button
          class="page-context-action__compact-scroll-top-btn"
          id="page-context-action-scroll-top"
          type="button"
          aria-label="Scroll to top">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round">
            <line x1="12" y1="19" x2="12" y2="5" />
            <polyline points="5 12 12 5 19 12" />
          </svg>
        </button>
      )}

      {showKebab && (
        <div class="page-context-action__compact-kebab-wrapper">
          <button
            class="page-context-action__compact-kebab-btn"
            id="page-context-action-kebab"
            type="button"
            aria-label="More actions"
            aria-expanded="false">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <circle cx="12" cy="5" r="2" />
              <circle cx="12" cy="12" r="2" />
              <circle cx="12" cy="19" r="2" />
            </svg>
          </button>
          <div class="page-context-action__popup" id="page-context-action-dropdown" style="display:none">
            {actions.copy && (
              <button class="page-context-action__popup-item" data-compact-copy type="button">
                <span class="page-context-action__popup-item-content">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                  </svg>
                  <span>Copy page</span>
                </span>
              </button>
            )}
            {actions.viewMarkdown && (
              <a
                class="page-context-action__popup-item"
                href={`${base.replace(/\/$/, "")}/${rawSourcePath}`}
                target="_blank"
                rel="noopener noreferrer">
