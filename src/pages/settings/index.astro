---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

import { SettingsForm } from "@/components/settings/form";
import { generateHeadMeta } from "@/lib/generateHeadMeta";

const pageUrl = Astro.url.href;
const pageDescription =
  "Tailor all documentation and guides to your specific environment. Enter your paths, IP’s and more to generate ready-to-use code snippets.";

const headings = [
  { depth: 3, slug: "networking", text: "Networking" },
  { depth: 3, slug: "docker", text: "Docker" },
  { depth: 3, slug: "hdd", text: "HDD" },
  { depth: 3, slug: "file-sharing", text: "File Sharing" },
];

const headMeta = generateHeadMeta({
  pageTitle: "Settings",
  pageDescription,
  pageUrl,
});
---

<StarlightPage
  frontmatter={{
    title: "Settings",
    head: [
      ...headMeta,
      {
        tag: "style",
        content: `
          .content-panel {
            padding-inline: 2rem;
          }
          .sl-markdown-content :not(a, strong, em, del, span, input, code, br) + :not(a, strong, em, del, span, input, code, br, :where(.not-content *)) {
            margin-top: 0;
          }
          mobile-page-context-actions,
          .page-context-action__wrapper {
            display: none;
          }
        `,
      },
    ],

    tableOfContents: { minHeadingLevel: 2, maxHeadingLevel: 3 },
    prev: false,
    next: false,
    pagefind: false,
  }}
  headings={headings}>
  <SettingsForm client:only="preact" pageDescription={pageDescription} />
</StarlightPage>
