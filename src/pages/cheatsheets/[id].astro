---
import { Badge, Code, Icon } from "@astrojs/starlight/components";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { getCollection } from "astro:content";

import { borderColorVariants, colorVariants } from "@/lib/constants";
import { generateHeadMeta } from "@/lib/generateHeadMeta";
import { capitalize, getVariant, slugify } from "@/lib/utils";

export async function getStaticPaths() {
  const cheatsheets = await getCollection("cheatsheets");
  return cheatsheets.map((cheatsheet) => ({
    params: { id: cheatsheet.id },
    props: { cheatsheet },
  }));
}

const { cheatsheet } = Astro.props;
const pageUrl = Astro.url.href;

const headings = cheatsheet.data.groups.flatMap((group) => [
  { depth: 2, slug: slugify(group.title), text: group.title },
  ...(group.items || []).map((item) => ({
    depth: 3,
    slug: slugify(item.label),
    text: item.label,
  })),
]);

const platformsFound = new Set<string>();
cheatsheet.data.groups.forEach((group) => {
  group.items?.forEach((item) => {
    item.platforms?.forEach((p) => {
      p.os.forEach((os) => platformsFound.add(os));
    });
  });
});
const availablePlatforms = Array.from(platformsFound).sort();
const showToggle = availablePlatforms.length > 0;

const headMeta = generateHeadMeta({
  pageTitle: `${cheatsheet.data.title} Cheatsheet`,
  pageDescription: cheatsheet.data.description,
  pageUrl,
});
---

<StarlightPage
  headings={headings}
  frontmatter={{
    title: cheatsheet.data.title,

    head: [
      ...headMeta,
      {
        tag: "style",
        content: `
          .sl-markdown-content .platform-toggle-bar .platform-btn,
          .sl-markdown-content .platform-toggle-bar .platform-btn + .platform-btn {
            margin-top: 0;
          }
        `,
      },
    ],
    tableOfContents: true,
    prev: false,
    next: false,
  }}>
  <p style="margin-top: -20px; margin-bottom: 20px;">{cheatsheet.data.description}</p>

  {
    showToggle && (
      <div class="platform-toggle-bar" role="toolbar" aria-label="Filter cheatsheets by platform">
        <button class="platform-btn active" data-filter="all" aria-pressed="true" aria-label="Show all platforms">
          <Icon name="seti:html" />
          <span class="platform-text">All</span>
        </button>
        {availablePlatforms.map((os) => {
          console.log("___ __", os);
          const formattedOs = os === "macos" ? "macOS" : capitalize(os);
          const iconName = os === "windows" ? "seti:windows" : os === "linux" ? "linux" : "apple";
          return (
            <button class="platform-btn" data-filter={os} aria-pressed="false" aria-label={`Filter by ${formattedOs}`}>
              <Icon name={iconName} />
              <span class="platform-text">{formattedOs}</span>
            </button>
          );
        })}
      </div>
    )
  }

  {
    cheatsheet.data.groups.map((group) => (
      <div>
        <h2 id={slugify(group.title)}>{group.title}</h2>
        <p class="group-description">{group.description}</p>

        {group?.syntax && (
          <div class="no-copy" style="margin-bottom: 20px;">
            <Code lang="sh" preserveIndent code={group.syntax} />
          </div>
        )}

        {group?.items && (
          <div class="grid">
            {group.items.map((item, index) => {
              const renderBlocks = [];

              if (item.commands || item.code || item.example || item.regex) {
                renderBlocks.push({
                  osList: "universal",
                  osArray: ["universal"],
                  payload: item,
                });
              }

              if (item.platforms) {
                item.platforms.forEach((p) => {
                  renderBlocks.push({
                    osList: p.os.join(","),
                    osArray: p.os,
                    payload: p,
                  });
                });
              }

              return (
                <div
                  class="cheatsheet-card"
                  style={{
                    borderColor: getVariant(borderColorVariants, index),
                    color: getVariant(colorVariants, index),
                  }}>
                  <h3 id={slugify(item.label)}>{item.label}</h3>
                  <p class="item-description">{item.description}</p>

                  <div class="code-example">
                    {renderBlocks.map((block) => (
                      <div class="platform-block" data-os-list={block.osList}>
                        {block.osList !== "universal" && (
                          <div class="os-tags-wrapper">
                            {block.osArray.map((osName) => {
                              const variant = osName === "windows" ? "note" : osName === "linux" ? "caution" : "tip";
                              const badgeText = osName === "macos" ? "macOS" : capitalize(osName);
                              return (
                                <span data-os-name={osName} style="display: inline-block;">
                                  <Badge text={badgeText} variant={variant} size="small" />
                                </span>
                              );
                            })}
                          </div>
                        )}

                        {block.payload?.code && (
                          <Code lang={block.payload.codeLang ?? "sh"} wrap preserveIndent code={block.payload.code} />
                        )}

                        {block.payload?.commands?.length && (
                          <div class="commands-wrapper">
                            {block.payload.commands.map((cmd, cmdIndex) => (
                              <>
                                {cmdIndex > 0 && <span class="or-separator">or</span>}
                                <div class="command">
                                  {cmd.map((key, keyIndex) => (
                                    <>
                                      <kbd
                                        class="kbd"
                                        style={{
                                          borderColor: getVariant(borderColorVariants, index),
                                          boxShadow: `1px 1px 2px 0 ${getVariant(borderColorVariants, index)}`,
                                        }}>
                                        {key}
                                      </kbd>
                                      {keyIndex + 1 !== cmd.length && <span>+</span>}
                                    </>
                                  ))}
                                </div>
                              </>
                            ))}
                          </div>
                        )}

                        {block.payload?.regex?.steps?.length && (
                          <div class="regex-wrapper">
                            {block.payload.regex.steps.map((step) => (
                              <div class="regex-step">
                                <div>
                                  <Code title="Find" wrap preserveIndent code={step.find} />
                                </div>
                                <div>
                                  <Code title="Replace" wrap preserveIndent code={step.replace} />
                                </div>
                              </div>
                            ))}
                          </div>
                        )}

                        {block.payload.example && (
                          <div
                            class={
                              Boolean(block.payload.regex?.steps?.length) || block.payload.codeLang === "regex"
                                ? "no-copy"
                                : undefined
                            }>
                            <Code
                              title="Example"
                              lang={block.payload.codeLang === "regex" ? "txt" : (block.payload.codeLang ?? "sh")}
                              wrap
                              preserveIndent
                              code={block.payload.example}
                            />
                          </div>
                        )}

                        {block.osList !== "universal" && block.payload.comment && (
                          <div class="comment">{block.payload.comment}</div>
                        )}
                      </div>
                    ))}

                    {item.comment && <div class="comment">{item.comment}</div>}
                  </div>
                </div>
              );
            })}
          </div>
        )}
      </div>
    ))
  }
</StarlightPage>

<script>
  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    const btn = target.closest(".platform-btn");
    if (!btn) return;

    const buttons = document.querySelectorAll(".platform-btn");
    buttons.forEach((b) => b.classList.remove("active"));
    btn.classList.add("active");

    const selectedOS = btn.getAttribute("data-filter");
    const cards = document.querySelectorAll(".cheatsheet-card");

    cards.forEach((card) => {
      const blocks = card.querySelectorAll(".platform-block");

      blocks.forEach((block) => {
        const blockEl = block as HTMLElement;
        const osListAttr = block.getAttribute("data-os-list") || "";
        const osArray = osListAttr.split(",");
        const tags = block.querySelectorAll(".os-tag");

        if (selectedOS === "all") {
          blockEl.style.display = "block";
          tags.forEach((tag) => {
            (tag as HTMLElement).style.display = "inline-block";
          });
        } else {
          if (osListAttr === "universal" || (selectedOS && osArray.includes(selectedOS))) {
            blockEl.style.display = "block";

            tags.forEach((tag) => {
              const tagEl = tag as HTMLElement;
              const osName = tag.getAttribute("data-os-name");
              if (osName === selectedOS) {
                tagEl.style.display = "inline-block";
              } else {
                tagEl.style.display = "none";
              }
            });
          } else {
            blockEl.style.display = "none";
          }
        }
      });
    });
  });
</script>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(400px, 100%), 1fr));
    gap: 10px;
    margin: 0 auto 30px;
  }

  h2 {
    margin-bottom: 5px;
  }

  .cheatsheet-card {
    padding: clamp(1rem, calc(0.125rem + 1.5vw), 2.5rem);
    border-radius: 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
  }

  .platform-toggle-bar {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    margin-bottom: 2rem;
    gap: 0;
  }

  .platform-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg);
    cursor: pointer;
    color: var(--sl-color-text);
    font-size: 0.875rem;
    font-family: inherit;
    border-radius: 0;
    margin-left: -1px;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .platform-toggle-bar .platform-btn:first-of-type {
    border-top-left-radius: var(--sl-border-radius, 0.5rem);
    border-bottom-left-radius: var(--sl-border-radius, 0.5rem);
    margin-left: 0;
  }

  .platform-toggle-bar .platform-btn:last-of-type {
    border-top-right-radius: var(--sl-border-radius, 0.5rem);
    border-bottom-right-radius: var(--sl-border-radius, 0.5rem);
  }

  .platform-btn:hover {
    position: relative;
    z-index: 1;
    border-color: var(--sl-color-accent);
  }

  .platform-btn.active {
    position: relative;
    z-index: 2;
    background: var(--sl-color-accent);
    color: var(--sl-color-text-invert);
    border-color: var(--sl-color-accent);
  }

  .platform-icon {
    flex-shrink: 0;
  }

  @media (max-width: 799px) {
    .platform-btn {
      padding: 0.5rem;
    }

    .platform-text {
      display: none;
    }
  }

  .os-tags-wrapper {
    display: flex;
    gap: 4px;
    margin-bottom: 4px;
  }

  .group-description,
  .item-description {
    margin-bottom: 10px;
  }

  .code-example {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .regex-wrapper {
    display: grid;
    gap: 35px;
  }

  .regex-step {
    display: grid;
    gap: 10px;
  }

  .comment {
    margin-top: 10px;
    font-size: 0.8rem;
    font-family: monospace;
    line-height: normal;
    color: var(--sl-color-gray-3);
  }

  .commands-wrapper {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .command {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .kbd {
    display: inline-block;
    padding: 3px 6px;
    background-color: var(--sl-color-bg-inline-code);
    border-width: 1px;
    border-style: outset;
    border-radius: 5px;
    font-family: monospace;
    text-align: center;
  }

  .no-copy .copy {
    display: none;
  }
</style>
