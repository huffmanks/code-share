---
import Icon from "@/components/icon.astro";
import Default from "@astrojs/starlight/components/SocialIcons.astro";
import type { Props } from "@astrojs/starlight/props";
---

<a href="https://github.com/huffmanks" rel="noopener" target="_blank" class="social-icon-link">
  <span class="sr-only">GitHub</span>
  <Icon name="github-icon" />
</a>
<a href="https://linkedin.com/in/huffmanks" rel="noopener" target="_blank" class="social-icon-link">
  <span class="sr-only">LinkedIn</span>
  <Icon name="linkedin-icon" />
</a>
<a href="https://huffmanks.com" rel="noopener" target="_blank" class="social-icon-link">
  <span class="sr-only">huffmanks.com</span>
  <Icon name="huffmanks-icon" />
</a>

<Default {...Astro.props}><slot /></Default>
