---
import Icon from "@/components/icon.astro";
import type { IconName } from "@/types";

type Props = {
  references: {
    href: string;
    label: string;
    icon?: IconName;
  }[];
};

const { references } = Astro.props;
---

<ul>
  {
    references.map((ref) => (
      <li>
        <a class="link" href={ref.href} target="_blank" rel="noopener">
          {ref.label} {ref?.icon && <Icon name={ref.icon} />}
        </a>
      </li>
    ))
  }
</ul>

<style is:inline>
  .sl-container .sl-markdown-content a:not(:where(.not-content .link)) {
    color: var(--sl-color-text-accent);
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
  }

  .sl-container .sl-markdown-content a:is(:hover, :focus-visible):not(:where(.not-content .link)) {
    color: var(--sl-color-accent);
  }
</style>
