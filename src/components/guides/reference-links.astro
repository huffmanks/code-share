---
import Icon from "@/components/icon.astro";
import type { References } from "@/content.config";

type Props = {
  references?: References;
};

const { references } = Astro.props;
---

{
  references && references.length > 0 && (
    <ul>
      {references.map((ref) => {
        if ("heading" in ref) {
          return (
            <li>
              <span>{ref.heading}</span>
              <ul>
                {ref.items.map((item) => (
                  <li>
                    <a class="link" href={item.href} target="_blank" rel="noopener">
                      {item.label} {item.icon && <Icon name={item.icon} />}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          );
        }

        return (
          <li>
            <a class="link" href={ref.href} target="_blank" rel="noopener">
              {ref.label} {ref.icon && <Icon name={ref.icon} />}
            </a>
          </li>
        );
      })}
    </ul>
  )
}

<style is:inline>
  .sl-container .sl-markdown-content a:not(:where(.not-content .link)) {
    color: var(--sl-color-text-accent);
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
  }

  .sl-container .sl-markdown-content a:is(:hover, :focus-visible):not(:where(.not-content .link)) {
    color: var(--sl-color-accent);
  }
</style>
