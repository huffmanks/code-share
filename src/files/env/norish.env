AUTH_URL=https://norish.{{BASE_SUB_DOMAIN_VAR}}
DATABASE_URL=postgres://postgres:norish@db:5432/norish
MASTER_KEY=# openssl rand -base64 32
VALKEY_URL=valkey://valkey:6379

OBSCURA_ENDPOINT=ws://obscura:9222
OBSCURA_CDP_TOKEN=# openssl rand -base64 32

POSTGRES_USER=postgres
POSTGRES_PASSWORD=norish
POSTGRES_DB=norish

# Optional
UPLOADS_DIR=/app/uploads

TRUSTED_ORIGINS={{SERVER_IP_VAR}}:3009,http://localhost:3009,https://norish.{{BASE_SUB_DOMAIN_VAR}}
TRUSTED_PROXIES=172.16.0.0/12,{{SUBNET_VAR}}

DEFAULT_LOCALE=en
ENABLED_LOCALES=en

PASSWORD_AUTH_ENABLED=true